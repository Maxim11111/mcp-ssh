# MCP SSH Server Configuration
# Copy this file to .env and adjust values as needed

# Server Configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Public URL clients use to reach this service (no trailing path). Required for OAuth
# metadata (RFC 9728) and Claude Code / MCP Inspector. Use https:// in production.
# Local: http://127.0.0.1:8000  Docker from host: http://localhost:8000
PUBLIC_BASE_URL=http://127.0.0.1:8000

# External Port (Docker host port mapping)
EXTERNAL_PORT=8000

# Directory Configuration
CONFIG_DIR=/app/config
KEYS_DIR=/app/keys
LOGS_DIR=/app/logs

# Security Settings
TOKEN_EXPIRY_HOURS=8760

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=500

# SSH Settings
SSH_CONNECTION_TIMEOUT=30
SSH_COMMAND_TIMEOUT=300

# Development Settings
DEBUG=false
RELOAD=false

# Optional: SSH Key Passphrases (if needed)
# PROD_SSH_PASSPHRASE=your-passphrase
# TEST_SSH_PASSPHRASE=your-passphrase

# Reverse Proxy Configuration
# For reverse proxy setups, use docker-compose.proxy.yml instead:
# docker-compose -f docker-compose.yml -f docker-compose.proxy.yml up -d
