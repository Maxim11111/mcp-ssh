      "^machinectl ",
      "^busctl ",
      "^systemctl ",
      "^service ",
      "^chkconfig ",
      "^update-rc.d ",
      "^rc-status ",
      "^rc-service ",
      "^openrc ",
      "^initctl ",
      "^start ",
      "^stop ",
      "^restart ",
      "^reload ",
      "^status ",
      "^reload-or-restart ",
      "^try-restart ",
      "^condrestart ",
      "^force-reload ",
      "^mask ",
      "^unmask ",
      "^enable ",
      "^disable ",
      "^is-enabled ",
      "^is-active ",
      "^is-failed ",
      "^show ",
      "^list-dependencies ",
      "^list-units ",
      "^list-sockets ",
      "^list-timers ",
      "^list-jobs ",
      "^daemon-reload ",
      "^daemon-reexec ",
      "^reset-failed ",
      "^cat /proc/",
      "^cat /sys/",
      "^cat /etc/",
      "^cat /var/log/",
      "^cat /tmp/",
      "^cat /dev/",
      "^cat /usr/",
      "^cat /opt/",
      "^cat /home/",
      "^cat /root/"
    ],
    "forbidden_commands": [
      "rm -rf /",
      "mkfs",
      "dd if=/dev/zero",
      "> /dev/sda",
      ":(){ :|:& };:",
      "chmod 777 /",
      "chown root:root /"
    ],
    "require_confirmation": [
      "reboot",
      "shutdown",
      "halt",
      "poweroff",
      "init 0",
      "init 6",
      "rm -rf",
      "mkfs"
    ],
    "rate_limit": {
      "requests_per_minute": 60,
      "commands_per_hour": 500
    }
  }
}


