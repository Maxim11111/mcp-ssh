{
  "servers": {
    "prod-web-01": {
      "host": "192.168.1.10",
      "port": 22,
      "user": "deploy",
      "ssh_key_path": "/app/keys/prod_web_ed25519",
      "ssh_key_passphrase_env": null,
      "tags": ["production", "web"],
      "enabled": true,
      "description": "Production web server 01"
    },
    "prod-db-01": {
      "host": "192.168.1.20",
      "port": 22,
      "user": "deploy",
      "ssh_key_path": "/app/keys/prod_db_ed25519",
      "ssh_key_passphrase_env": "PROD_DB_SSH_PASSPHRASE",
      "tags": ["production", "database"],
      "enabled": true,
      "description": "Production database server 01"
    },
    "test-web-01": {
      "host": "192.168.2.10",
      "port": 22,
      "user": "ubuntu",
      "ssh_key_path": "/app/keys/test_ed25519",
      "ssh_key_passphrase_env": null,
      "tags": ["testing", "web"],
      "enabled": true,
      "description": "Test web server 01"
    }
  },
