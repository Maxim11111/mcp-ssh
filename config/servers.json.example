      "^visudo ",
      "^last ",
      "^lastlog ",
      "^who ",
      "^w ",
      "^finger ",
      "^loginctl ",
      "^systemd-analyze ",
      "^systemd-cgtop ",
      "^systemd-delta ",
      "^systemd-resolve ",
