      "^unset ",
      "^alias ",
      "^history ",
      "^echo ",
      "^printf ",
      "^date ",
      "^cal ",
      "^sleep ",
      "^kill ",
      "^killall ",
      "^pkill ",
      "^pgrep ",
      "^nohup ",
